<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Time Forecast</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
</head>
<body onload="getCountries();">
    <section class="vh-100">
        <div class="container py-5 h-100">
            <div class="row d-flex justify-content-center align-items-center h-100">
                <div class="col-md-8 col-lg-6 col-xl-4">
                    <h3 class="mb-4 pb-2 fw-normal">Check the Time Forecast</h3>
                    <div class="input-group rounded mb-3">
                        <select class="form-control rounded" id="countrylist" onchange="getStates(this.value)">
                            <!-- Country options will be populated here -->
                        </select>
                        <select class="form-control rounded" id="statelist" onchange="getCities(this.value)">
                            <option value="0">--- Select State ---</option>
                        </select>
                        <select class="form-control rounded" id="citylist" onchange="fetchTimeData(this.value)">
                            <option value="0">--- Select City ---</option>
                        </select>
                    </div>
                    <div class="card shadow-0 border">
                        <div class="card-body p-4">
                            <h4 class="mb-1 fw-normal" id="cityname"></h4>
                            <p id="time">Current Time: <strong></strong></p>
                            <p id="date">Date: <strong></strong></p>
                            <p id="day">Day: <strong></strong></p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <script src="/js/demo.js"></script>
</body>
</html>
